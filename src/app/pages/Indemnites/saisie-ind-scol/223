              </button>
            </div>

          </div>
        </div>

      </div>
      <div class="table-responsive table-card mb-2">
        <table class="table">
          <thead>
            <!-- Search Filters Row -->

            <tr class="bg-light">
              <th>Sélectionner Tous</th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.mat_pers"
                  (input)="applyFilter()" placeholder="Rechercher..." />

              </th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.nom_pers"
                  (input)="applyFilter()" placeholder="Rechercher..." />
              </th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.num_fam"
                  (input)="applyFilter()" placeholder="Rechercher..." />
              </th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.mnt_dem_don"
                  (input)="applyFilter()" placeholder="Rechercher..." />
              </th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.mnt_livre"
                  (input)="applyFilter()" placeholder="Rechercher..." />
              </th>
              <th>
                <input type="text" class="form-control form-control-sm" [(ngModel)]="searchz.mode_payement"
                  (input)="applyFilter()" placeholder="Rechercher..." />
              </th>
            </tr>
            <!-- Table Headers Row -->
            <tr class="table-primary">
              <th scope="col" style="width: 50px">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="checkAll" [(ngModel)]="masterSelected"
                    (change)="checkUncheckAll($event)" />
                </div>
              </th>
              <th class="sort" (click)="onSort('mat_pers')">Matricule</th>
              <th class="sort" (click)="onSort('nom_pers')">Nom & Prénom</th>
              <th class="sort" (click)="onSort('num_fam')">Num Famille</th>

              <th class="sort" (click)="onSort('mnt_dem_don')">Montant</th>
              <th class="sort" (click)="onSort('mnt_livre')">Montant livre</th>

              <th class="sort" (click)="onSort('mode_payement')">Mode payement</th>
              <th class="sort">Action</th>

            </tr>
          </thead>

          <tbody>
            <tr *ngFor="let data of listDem | paginate: { itemsPerPage: 12, currentPage: pSusp }; let i = index"
              [ngClass]="{'bg-light': i % 2 === 0, 'bg-white': i % 2 !== 0}"
              [ngClass]="{ 'table-active': selectedRow === i }">

              <th scope="row">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="checkAll" [(ngModel)]="data.state"
                    (change)="onCheckboxChange()" />
                </div>
              </th>
              <td>{{ data.mat_pers }}</td>

              <td>
                {{data.nom_pers }}
              </td>
              <td>
                {{data.num_fam }}
              </td>

              <td class="text-end">
                {{data.mnt_dem_don | number: '1.3-3'}}
              </td>
              <td class="text-end">
                {{ data.mnt_livre | number: '1.3-3'}}
              </td>
              <td >
                {{
                data.mode_payement === 'E' ? 'Espèce' :
                data.mode_payement === 'V' ? 'Virement' :
                data.mode_payement === 'C' ? 'Chèque' :
                data.mode_payement
