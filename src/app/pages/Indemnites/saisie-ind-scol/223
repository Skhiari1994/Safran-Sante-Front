<div class="row" style="margin-top: 25px;"></div>
<div class="row sticky-top" style="z-index: 1025; top: 121px;">
  <app-breadcrumbs title="Saisie des indemnités Scolaire" [breadcrumbItems]="breadCrumbItems"></app-breadcrumbs>
</div>

<div class="col-xl-12">
  <div class="card p-4 border shadow-none mb-0 mt-4">
    <form action="javascript:void(0);" class="row g-3">

      <!-- Row 1: Direction -->

      <div class="col-2">
        <label for="billinginfo-phone" class="form-label">
          Direction</label>

        <app-lov [listData]="listLieu" [columns]="columnsLieu" [codeField]="codLieu" [selectedCode]="codLieuVal"
          (selectedValue)="onSelectedValueLieu($event)">
        </app-lov>
      </div>
      <div class="col-md-6">
        <label for="billinginfo-phone" class="form-label">
          Libellé</label>
        <input type="text" class="form-control border-primary" [value]="libLieu" placeholder="Direction" readonly />
      </div>

      <div class="col-md-4">

      </div>
      <!-- Row 2: Motif de départ, Libellé de motif de départ, Etat Actif -->
      <div class="col-md-2">
        <label for="billinginfo-phone" class="form-label">Type don</label>
        <app-lov [listData]="listTypDon" [columns]="columnsNat" codeField="nat_Don" [selectedCode]="typDonVal"
          (selectedValue)="onSelectedValueTypDon($event)">
        </app-lov>
      </div>
      <div class="col-md-6">
        <label for="billinginfo-phone" class="form-label">Libellé don</label>
        <input type="text" class="form-control border-primary" placeholder="Type don" [value]="libNatDon" readonly />
      </div>

      <div class="col-md-3">
        <label for="billinginfo-prenom" class="form-label">Plafond </label>

        <input type="text" class="form-control border-primary" [value]=max_mnt_don />
      </div>


    </form>
  </div>
</div>

<div class="col-xl-12">




  <div class="card p-4 border shadow-none mb-0 mt-4">
