<ng-template #content1 role="document" let-modal>
  <div class="modal-header bg-info-subtle p-3">
    <h5 class="modal-title" id="exampleModalLabel">Saisie indémnité</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"
      (click)="modal.dismiss('Cross click')"></button>
  </div>
  <form [formGroup]="formSaiseIndScol" class="tablelist-form" autocomplete="off">
    <div class="modal-body">
      <div class="row g-2">
        <div class="col-md-2">
          <label for="billinginfo-phone" class="form-label">Matricule
          </label>
          <app-lov [listData]="listPersonnel" [columns]="columnsSearch" codeField="mat_pers" [selectedCode]="codMatVal"
            (selectedValue)="onSelectedValue($event)"></app-lov>
        </div>

        <div class="col-md-4">
          <label for="billinginfo-nom" class="form-label">Nom & Prénom</label>
          <input type="text" class="form-control border-primary" placeholder="Entrer Nom" formControlName="nom_pers" />
        </div>

        <div class="col-md-2">
          <label for="name-field" class="form-label">Numéro famille</label>
          <app-lov [listData]="listFamille" [columns]="columnFamille" codeField="num_fam"
            [selectedCode]="codActiviteVal" (selectedValue)="onSelectedValueFamille($event)">
          </app-lov>
        </div>

        <div class="col-md-4">
          <label for="owner-field" class="form-label">Prénom</label>
          <input type="text" class="form-control border-primary" formControlName="nom_fam" />
        </div>



        <div class="col-md-3">
          <label for="name-field" class="form-label">Montant</label>
          <input type="text" class="form-control border-primary" placeholder="Entrer le montant demander"
            formControlName="mnt_dem_don" />
          <!-- Error message for required validation -->

        </div>
        <div class="col-md-3">
          <label for="name-field" class="form-label">Montant Livre</label>
          <input type="text" class="form-control border-primary" placeholder="Entrer le montant demander"
            formControlName="mnt_livre" />
          <div
            *ngIf="formSaiseIndScol.get('mnt_livre')?.hasError('required') && formSaiseIndScol.get('mnt_livre')?.touched"
            class="text-danger">
            Le montant demandé est obligatoire.
          </div>
          <!-- Error message for plafond validation -->
          <div
            *ngIf="formSaiseIndScol.get('mnt_livre')?.hasError('exceedsPlafond') && formSaiseIndScol.get('mnt_livre')?.touched"
            class="text-danger">
            Le montant demandé doit être inférieur ou égal à la valeur du plafond.
          </div>

        </div>
        <div class="col-md-3">
          <label for="billinginfo-phone" class="form-label">Mode payment</label>
          <select class="form-select border-success" formControlName="mode_payement"
            (change)="getValueModPay($event.target.value)">
            <option value="V">Virement</option>
            <option value="E">Espéce</option>
            <option value="C">Chèque</option>
          </select>
        </div>
      </div>
    </div>

    <div class="modal-footer">
      <div class="hstack gap-2 justify-content-end">
        <button type="button" class="btn btn-success" data-bs-dismiss="modal" [disabled]="!isFormValid"
