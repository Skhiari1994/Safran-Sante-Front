          Valider
        </button>
      </div>
      <div class="hstack gap-2 justify-content-end">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal" (click)="modal.close('Close click')">
          Close
        </button>
      </div>
    </div>
  </form>

</ng-template>
<ng-template #deleteModel let-modal>
